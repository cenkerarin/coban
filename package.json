{
  "name": "coban",
  "version": "0.3.0",
  "description": "A terminal app where one orchestrator agent dispatches work to many AI coding agents — several Claude Code accounts, Codex, OpenCode, Cursor — that message each other over a shared board.",
  "scripts": {
    "postinstall": "node -e \"for(const a of ['darwin-arm64','darwin-x64','linux-x64','linux-arm64']){try{require('fs').chmodSync(require.resolve('node-pty/package.json').replace('package.json','prebuilds/'+a+'/spawn-helper'),0o755)}catch{}}\"",
    "test": "COBAN_NO_NOTIFY=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "snapshot": "node --disable-warning=ExperimentalWarning scripts/snapshot.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestrator",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "terminal",
    "tui"
  ],
  "author": "cenkerarin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "bin": {
    "coban": "bin/coban"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cenkerarin/coban.git"
  },
  "homepage": "https://github.com/cenkerarin/coban#readme",
  "bugs": {
    "url": "https://github.com/cenkerarin/coban/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ]
}
