{
  "name": "coban",
  "version": "0.1.0",
  "description": "A terminal app where one orchestrator agent dispatches tasks to many AI coding agents (multiple Claude accounts, Codex, OpenCode, Cursor) that can talk to each other.",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper || true"
  },
  "keywords": [
    "ai",
    "agents",
    "terminal",
    "orchestrator",
    "claude-code",
    "codex",
    "tui"
  ],
  "author": "cenkerarin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "bin": {
    "coban": "bin/coban"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
